rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOrProvisionedUser() {
      return isEmailVerified() || (isSignedIn() && exists(userPath(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCompositeId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function platformAdminPath(uid) {
      return /databases/$(database)/documents/platformAdmins/$(uid);
    }

    function isPlatformAdmin() {
      return (isEmailVerified() && request.auth.token.email == 'appiahkubi848@gmail.com') ||
        (
          isEmailVerified() &&
          exists(platformAdminPath(request.auth.uid)) &&
          get(platformAdminPath(request.auth.uid)).data.isActive == true
        );
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function rolePath(roleId) {
      return /databases/$(database)/documents/roles/$(roleId);
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function branchPath(branchId) {
      return /databases/$(database)/documents/branches/$(branchId);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function subscriptionPath(subscriptionId) {
      return /databases/$(database)/documents/subscriptions/$(subscriptionId);
    }

    function membershipPath(tenantId, uid) {
      return /databases/$(database)/documents/tenantMemberships/$(tenantId + '_' + uid);
    }

    function hasUserProfile() {
      return isVerifiedOrProvisionedUser() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function isOrgOwner(orgId) {
      return isSignedIn() &&
        exists(orgPath(orgId)) &&
        get(orgPath(orgId)).data.ownerUid == request.auth.uid;
    }

    function isBootstrapOrgOwner(orgId) {
      return isOrgOwner(orgId) && !exists(tenantPath(orgId));
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        checkOrgMemberDoc(get(userPath(request.auth.uid)).data, orgId);
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (
        isOrgMember(tenantId) ||
        (
          exists(membershipPath(tenantId, request.auth.uid)) &&
          get(membershipPath(tenantId, request.auth.uid)).data.status == 'active'
        )
      );
    }

    function isTenantOperational(orgId) {
      return !exists(tenantPath(orgId)) || (
        get(tenantPath(orgId)).data.status == 'active' &&
        (
          !exists(subscriptionPath(get(tenantPath(orgId)).data.subscriptionId)) ||
          get(subscriptionPath(get(tenantPath(orgId)).data.subscriptionId)).data.status in ['trial', 'active', 'grace_period']
        )
      );
    }

    function checkOrgMemberDoc(user, orgId) {
      return user.accountStatus == 'active' && user.organizationId == orgId;
    }

    function checkSuperAdminWithUser(user, orgId) {
      let role = get(rolePath(user.roleId)).data;
      return checkOrgMemberDoc(user, orgId) &&
        role.isActive == true &&
        role.scope == 'organization';
    }

    function checkSuperAdminDoc(user, orgId) {
      return exists(rolePath(user.roleId)) &&
        checkSuperAdminWithUser(user, orgId);
    }

    function checkBranchAccessDoc(user, orgId, branchId) {
      return checkOrgMemberDoc(user, orgId) && (
        (branchId in user.branchIds) ||
        checkSuperAdminDoc(user, orgId)
      );
    }

    function hasBranchAccess(orgId, branchId) {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        checkBranchAccessDoc(get(userPath(request.auth.uid)).data, orgId, branchId);
    }

    function checkPermWithRole(user, perm) {
      let role = get(rolePath(user.roleId)).data;
      return role.isActive == true && (
        role.scope == 'organization' ||
        (
          (!('deniedPermissions' in user) || !(perm in user.deniedPermissions)) &&
          (perm in role.permissions)
        )
      );
    }

    function checkPermissionDoc(user, orgId, perm) {
      return checkOrgMemberDoc(user, orgId) && (
        (
          (!('deniedPermissions' in user) || !(perm in user.deniedPermissions)) &&
          ('grantedPermissions' in user && perm in user.grantedPermissions)
        ) || (
          exists(rolePath(user.roleId)) &&
          checkPermWithRole(user, perm)
        )
      );
    }

    function hasPermission(orgId, perm) {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        checkPermissionDoc(get(userPath(request.auth.uid)).data, orgId, perm);
    }

    function checkBranchPermWithRole(user, branchId, perm) {
      let role = get(rolePath(user.roleId)).data;
      return role.isActive == true && (
        role.scope == 'organization' || (
          (branchId in user.branchIds) &&
          (!('deniedPermissions' in user) || !(perm in user.deniedPermissions)) &&
          (
            ('grantedPermissions' in user && perm in user.grantedPermissions) ||
            (perm in role.permissions)
          )
        )
      );
    }

    function checkBranchPermissionDoc(user, orgId, branchId, perm) {
      return checkOrgMemberDoc(user, orgId) && (
        (
          (branchId in user.branchIds) &&
          (!('deniedPermissions' in user) || !(perm in user.deniedPermissions)) &&
          ('grantedPermissions' in user && perm in user.grantedPermissions)
        ) || (
          exists(rolePath(user.roleId)) &&
          checkBranchPermWithRole(user, branchId, perm)
        )
      );
    }

    function hasBranchPermission(orgId, branchId, perm) {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        checkBranchPermissionDoc(get(userPath(request.auth.uid)).data, orgId, branchId, perm);
    }

    function checkBranchAnyPermWithRole(user, branchId, perms) {
      let role = get(rolePath(user.roleId)).data;
      return role.isActive == true && (
        role.scope == 'organization' || (
          (branchId in user.branchIds) && (
            (
              'grantedPermissions' in user && (
                (!('deniedPermissions' in user) && user.grantedPermissions.hasAny(perms)) ||
                ('deniedPermissions' in user && user.grantedPermissions.removeAll(user.deniedPermissions).hasAny(perms))
              )
            ) || (
              (!('deniedPermissions' in user) && role.permissions.hasAny(perms)) ||
              ('deniedPermissions' in user && role.permissions.removeAll(user.deniedPermissions).hasAny(perms))
            )
          )
        )
      );
    }

    function checkBranchAnyPermissionDoc(user, orgId, branchId, perms) {
      return checkOrgMemberDoc(user, orgId) && (
        (
          (branchId in user.branchIds) &&
          'grantedPermissions' in user && (
            (!('deniedPermissions' in user) && user.grantedPermissions.hasAny(perms)) ||
            ('deniedPermissions' in user && user.grantedPermissions.removeAll(user.deniedPermissions).hasAny(perms))
          )
        ) || (
          exists(rolePath(user.roleId)) &&
          checkBranchAnyPermWithRole(user, branchId, perms)
        )
      );
    }

    function hasAnyBranchPermission(orgId, branchId, perms) {
      return isSignedIn() &&
        exists(userPath(request.auth.uid)) &&
        checkBranchAnyPermissionDoc(get(userPath(request.auth.uid)).data, orgId, branchId, perms);
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)

    function isValidOrganization(data) {
      return data.keys().hasAll(['organizationId', 'businessName', 'currency', 'currencySymbol', 'timezone', 'defaultTaxRateBps', 'allowNegativeInventory', 'status', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['organizationId', 'businessName', 'registrationNumber', 'logoUrl', 'email', 'phone', 'address', 'country', 'currency', 'currencySymbol', 'timezone', 'defaultTaxRateBps', 'taxLabel', 'allowNegativeInventory', 'status', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidId(data.organizationId) &&
        data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160 &&
        (!('registrationNumber' in data) || (data.registrationNumber is string && data.registrationNumber.size() <= 80)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 8 &&
        data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
        data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 80 &&
        data.defaultTaxRateBps is int && data.defaultTaxRateBps >= 0 && data.defaultTaxRateBps <= 5000 &&
        (!('taxLabel' in data) || (data.taxLabel is string && data.taxLabel.size() <= 40)) &&
        data.allowNegativeInventory is bool &&
        data.status in ['active', 'suspended'] &&
        isValidId(data.ownerUid);
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['branchId', 'organizationId', 'branchCode', 'branchName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['branchId', 'organizationId', 'branchCode', 'branchName', 'address', 'city', 'region', 'country', 'contactNumber', 'email', 'managerName', 'operatingHours', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.branchId) &&
        isValidId(data.organizationId) &&
        data.branchCode is string && data.branchCode.size() >= 2 && data.branchCode.size() <= 32 &&
        data.branchName is string && data.branchName.size() >= 2 && data.branchName.size() <= 160 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        (!('region' in data) || (data.region is string && data.region.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        (!('contactNumber' in data) || (data.contactNumber is string && data.contactNumber.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('managerName' in data) || (data.managerName is string && data.managerName.size() <= 120)) &&
        (!('operatingHours' in data) || (data.operatingHours is string && data.operatingHours.size() <= 120)) &&
        data.status in ['active', 'suspended'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'organizationId', 'branchIds', 'defaultBranchId', 'roleId', 'grantedPermissions', 'deniedPermissions', 'accountStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'organizationId', 'branchIds', 'defaultBranchId', 'roleId', 'grantedPermissions', 'deniedPermissions', 'accountStatus', 'lastLogin', 'invitationId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        isValidId(data.organizationId) &&
        data.branchIds is list && data.branchIds.size() <= 50 &&
        (data.branchIds.size() == 0 || data.branchIds[0] is string) &&
        data.defaultBranchId is string && data.defaultBranchId.size() <= 128 &&
        isValidId(data.roleId) &&
        data.grantedPermissions is list && data.grantedPermissions.size() <= 100 &&
        (data.grantedPermissions.size() == 0 || data.grantedPermissions[0] is string) &&
        data.deniedPermissions is list && data.deniedPermissions.size() <= 100 &&
        (data.deniedPermissions.size() == 0 || data.deniedPermissions[0] is string) &&
        data.accountStatus in ['active', 'suspended', 'invited'] &&
        (!('invitationId' in data) || isValidId(data.invitationId));
    }

    function isValidRole(data) {
      return data.keys().hasAll(['roleId', 'organizationId', 'name', 'scope', 'permissions', 'isSystem', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['roleId', 'organizationId', 'name', 'description', 'scope', 'permissions', 'isSystem', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.roleId) &&
        isValidId(data.organizationId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.scope in ['organization', 'branch'] &&
        data.permissions is list && data.permissions.size() <= 100 &&
        (data.permissions.size() == 0 || data.permissions[0] is string) &&
        data.isSystem is bool &&
        data.isActive is bool;
    }

    function isValidPermissionDef(data) {
      return data.keys().hasAll(['permissionId', 'organizationId', 'module', 'action', 'label']) &&
        data.keys().hasOnly(['permissionId', 'organizationId', 'module', 'action', 'label', 'description']) &&
        data.permissionId is string && data.permissionId.size() >= 2 && data.permissionId.size() <= 80 &&
        isValidId(data.organizationId) &&
        data.module is string && data.module.size() >= 2 && data.module.size() <= 60 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 40 &&
        data.label is string && data.label.size() >= 2 && data.label.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240));
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['invitationId', 'organizationId', 'email', 'fullName', 'roleId', 'branchIds', 'defaultBranchId', 'status', 'invitedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['invitationId', 'organizationId', 'email', 'fullName', 'phone', 'roleId', 'branchIds', 'defaultBranchId', 'status', 'invitedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.invitationId) &&
        isValidId(data.organizationId) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        isValidId(data.roleId) &&
        data.branchIds is list && data.branchIds.size() <= 50 &&
        (data.branchIds.size() == 0 || data.branchIds[0] is string) &&
        data.defaultBranchId is string && data.defaultBranchId.size() <= 128 &&
        data.status in ['pending', 'accepted', 'revoked'] &&
        isValidId(data.invitedBy);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['categoryId', 'organizationId', 'name', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['categoryId', 'organizationId', 'name', 'description', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.categoryId) &&
        isValidId(data.organizationId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.status in ['active', 'archived'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['productId', 'organizationId', 'name', 'sku', 'costPriceMinor', 'sellingPriceMinor', 'taxCategory', 'minimumStock', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['productId', 'organizationId', 'categoryId', 'name', 'sku', 'barcode', 'description', 'brand', 'unit', 'imageUrl', 'costPriceMinor', 'sellingPriceMinor', 'wholesalePriceMinor', 'taxCategory', 'minimumStock', 'availableBranchIds', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.productId) &&
        isValidId(data.organizationId) &&
        (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 180 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 &&
        (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
        (!('brand' in data) || (data.brand is string && data.brand.size() <= 100)) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 40)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
        data.costPriceMinor is int && data.costPriceMinor >= 0 &&
        data.sellingPriceMinor is int && data.sellingPriceMinor >= 0 &&
        (!('wholesalePriceMinor' in data) || (data.wholesalePriceMinor is int && data.wholesalePriceMinor >= 0)) &&
        data.taxCategory in ['standard', 'exempt', 'zero'] &&
        data.minimumStock is int && data.minimumStock >= 0 &&
        (!('availableBranchIds' in data) || (data.availableBranchIds is list && data.availableBranchIds.size() <= 100)) &&
        data.status in ['active', 'archived'];
    }

    function isValidBranchInventory(data) {
      return data.keys().hasAll(['inventoryId', 'organizationId', 'branchId', 'productId', 'quantityAvailable', 'reorderLevel', 'costPriceMinor', 'sellingPriceMinor', 'updatedAt']) &&
        data.keys().hasOnly(['inventoryId', 'organizationId', 'branchId', 'productId', 'quantityAvailable', 'reorderLevel', 'costPriceMinor', 'sellingPriceMinor', 'updatedAt']) &&
        isValidCompositeId(data.inventoryId) &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        isValidId(data.productId) &&
        data.quantityAvailable is int &&
        (data.quantityAvailable >= 0 || get(orgPath(data.organizationId)).data.allowNegativeInventory == true) &&
        data.reorderLevel is int && data.reorderLevel >= 0 &&
        data.costPriceMinor is int && data.costPriceMinor >= 0 &&
        data.sellingPriceMinor is int && data.sellingPriceMinor >= 0;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['movementId', 'organizationId', 'branchId', 'productId', 'movementType', 'quantity', 'previousQuantity', 'newQuantity', 'performedBy', 'createdAt']) &&
        data.keys().hasOnly(['movementId', 'organizationId', 'branchId', 'productId', 'movementType', 'quantity', 'previousQuantity', 'newQuantity', 'referenceType', 'referenceId', 'reason', 'performedBy', 'createdAt']) &&
        isValidId(data.movementId) &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        isValidId(data.productId) &&
        data.movementType in ['sale', 'purchase_receipt', 'adjustment_add', 'adjustment_reduce', 'stock_count', 'damaged', 'expired', 'transfer_out', 'transfer_in', 'refund_restock', 'refund_damaged'] &&
        data.quantity is int &&
        data.previousQuantity is int &&
        data.newQuantity is int &&
        (!('referenceType' in data) || (data.referenceType is string && data.referenceType.size() <= 60)) &&
        (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
        isValidId(data.performedBy);
    }

    function isValidSale(data) {
      return data.keys().hasAll(['saleId', 'transactionNumber', 'idempotencyKey', 'organizationId', 'branchId', 'cashierId', 'itemCount', 'subtotalMinor', 'discountMinor', 'taxMinor', 'totalMinor', 'cogsMinor', 'paymentMethod', 'paymentStatus', 'saleStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['saleId', 'transactionNumber', 'idempotencyKey', 'organizationId', 'branchId', 'cashierId', 'cashierName', 'cashSessionId', 'customerId', 'customerName', 'itemCount', 'subtotalMinor', 'discountMinor', 'taxMinor', 'totalMinor', 'cogsMinor', 'amountTenderedMinor', 'changeMinor', 'paymentMethod', 'paymentStatus', 'saleStatus', 'createdAt', 'updatedAt']) &&
        isValidId(data.saleId) &&
        data.transactionNumber is string && data.transactionNumber.size() >= 4 && data.transactionNumber.size() <= 64 &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128 &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        isValidId(data.cashierId) &&
        (!('cashierName' in data) || (data.cashierName is string && data.cashierName.size() <= 160)) &&
        (!('cashSessionId' in data) || (data.cashSessionId is string && data.cashSessionId.size() <= 128)) &&
        (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128)) &&
        (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160)) &&
        data.itemCount is int && data.itemCount >= 1 &&
        data.subtotalMinor is int && data.subtotalMinor >= 0 &&
        data.discountMinor is int && data.discountMinor >= 0 &&
        data.taxMinor is int && data.taxMinor >= 0 &&
        data.totalMinor is int && data.totalMinor >= 0 &&
        data.cogsMinor is int && data.cogsMinor >= 0 &&
        (!('amountTenderedMinor' in data) || (data.amountTenderedMinor is int && data.amountTenderedMinor >= 0)) &&
        (!('changeMinor' in data) || (data.changeMinor is int && data.changeMinor >= 0)) &&
        data.paymentMethod in ['cash', 'mobile_money', 'card', 'bank_transfer', 'split'] &&
        data.paymentStatus in ['paid', 'partial', 'refunded'] &&
        data.saleStatus in ['completed', 'cancelled', 'refunded', 'partially_refunded'];
    }

    function isValidSaleItem(data) {
      return data.keys().hasAll(['itemId', 'saleId', 'organizationId', 'branchId', 'productId', 'productName', 'quantity', 'returnedQuantity', 'unitPriceMinor', 'costPriceMinor', 'discountMinor', 'taxMinor', 'lineTotalMinor']) &&
        data.keys().hasOnly(['itemId', 'saleId', 'organizationId', 'branchId', 'productId', 'productName', 'sku', 'quantity', 'returnedQuantity', 'unitPriceMinor', 'costPriceMinor', 'discountMinor', 'taxMinor', 'lineTotalMinor']) &&
        isValidId(data.itemId) &&
        isValidId(data.saleId) &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 180 &&
        (!('sku' in data) || (data.sku is string && data.sku.size() <= 64)) &&
        data.quantity is int && data.quantity >= 1 &&
        data.returnedQuantity is int && data.returnedQuantity >= 0 && data.returnedQuantity <= data.quantity &&
        data.unitPriceMinor is int && data.unitPriceMinor >= 0 &&
        data.costPriceMinor is int && data.costPriceMinor >= 0 &&
        data.discountMinor is int && data.discountMinor >= 0 &&
        data.taxMinor is int && data.taxMinor >= 0 &&
        data.lineTotalMinor is int && data.lineTotalMinor >= 0;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['paymentId', 'organizationId', 'branchId', 'saleId', 'method', 'amountMinor', 'status', 'createdAt']) &&
        data.keys().hasOnly(['paymentId', 'organizationId', 'branchId', 'saleId', 'method', 'amountMinor', 'reference', 'status', 'createdAt']) &&
        isValidId(data.paymentId) &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        isValidId(data.saleId) &&
        data.method in ['cash', 'mobile_money', 'card', 'bank_transfer'] &&
        data.amountMinor is int && data.amountMinor >= 0 &&
        (!('reference' in data) || (data.reference is string && data.reference.size() <= 120)) &&
        data.status in ['settled', 'manual_unintegrated', 'refunded'];
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['customerId', 'organizationId', 'branchId', 'fullName', 'totalPurchasesMinor', 'transactionCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['customerId', 'organizationId', 'branchId', 'fullName', 'phone', 'email', 'address', 'totalPurchasesMinor', 'transactionCount', 'createdAt', 'updatedAt']) &&
        isValidId(data.customerId) &&
        isValidId(data.organizationId) &&
        isValidId(data.branchId) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
