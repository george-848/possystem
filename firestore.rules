    function isValidFeatureOverride(data) {
      return data.keys().hasAll(['overrideId', 'tenantId', 'reason', 'expiresAt', 'status', 'grantedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['overrideId', 'tenantId', 'featureKey', 'enabled', 'limitOverrides', 'reason', 'expiresAt', 'status', 'grantedBy', 'grantedByEmail', 'createdAt', 'updatedAt']) &&
        isValidId(data.overrideId) &&
        isValidId(data.tenantId) &&
        (!('featureKey' in data) || (data.featureKey is string && data.featureKey.size() <= 64)) &&
        (!('enabled' in data) || data.enabled is bool) &&
        (!('limitOverrides' in data) || data.limitOverrides is map) &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 300 &&
        data.expiresAt is string && data.expiresAt.size() >= 4 && data.expiresAt.size() <= 64 &&
        data.status in ['active', 'revoked'] &&
        isValidId(data.grantedBy) &&
        (!('grantedByEmail' in data) || (data.grantedByEmail is string && data.grantedByEmail.size() <= 160));
    }

    function isValidPlatformAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 160 &&
        data.role in ['platform_owner', 'platform_support', 'billing_admin'] &&
        data.isActive is bool;
    }

    function isValidPlatformAuditLog(data) {
      return data.keys().hasAll(['logId', 'actorUid', 'action', 'resourceType', 'resourceId', 'details', 'createdAt']) &&
        data.keys().hasOnly(['logId', 'actorUid', 'actorEmail', 'targetTenantId', 'action', 'resourceType', 'resourceId', 'details', 'createdAt']) &&
        isValidId(data.logId) &&
        isValidId(data.actorUid) &&
        (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 160)) &&
        (!('targetTenantId' in data) || (data.targetTenantId is string && data.targetTenantId.size() <= 128)) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.resourceType is string && data.resourceType.size() >= 2 && data.resourceType.size() <= 80 &&
        data.resourceId is string && data.resourceId.size() >= 1 && data.resourceId.size() <= 128 &&
        data.details is string && data.details.size() <= 1000;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['ticketId', 'tenantId', 'tenantName', 'subject', 'category', 'priority', 'status', 'message', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ticketId', 'tenantId', 'tenantName', 'subject', 'category', 'priority', 'status', 'message', 'adminNotes', 'createdBy', 'createdByEmail', 'assignedTo', 'createdAt', 'updatedAt']) &&
        isValidId(data.ticketId) &&
        isValidId(data.tenantId) &&
        data.tenantName is string && data.tenantName.size() >= 1 && data.tenantName.size() <= 160 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160 &&
        data.category in ['billing', 'technical', 'entitlements', 'onboarding', 'other'] &&
        data.priority in ['low', 'medium', 'high', 'urgent'] &&
        data.status in ['open', 'in_progress', 'resolved', 'closed'] &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 2000 &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 2000)) &&
        isValidId(data.createdBy) &&
        (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() <= 160)) &&
        (!('assignedTo' in data) || (data.assignedTo is string && data.assignedTo.size() <= 128));
    }

    // 4. SaaS Platform & Billing Collections

    match /tenants/{tenantId} {
      allow get: if isValidId(tenantId) && isVerifiedOrProvisionedUser() && (isPlatformAdmin() || isTenantMember(tenantId) || isOrgOwner(tenantId));
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        existing().ownerUid == request.auth.uid ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      allow create: if isValidId(tenantId) && isSignedIn() && isValidTenant(incoming()) &&
        incoming().tenantId == tenantId &&
        incoming().organizationId == tenantId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().status == 'active' &&
            incoming().currentPlanId in ['starter', 'professional']
          )
        );
      allow update: if isValidId(tenantId) && isVerifiedOrProvisionedUser() && isValidTenant(incoming()) &&
        incoming().tenantId == existing().tenantId &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          (
            hasPermission(tenantId, 'settings.manage') &&
            isTenantOperational(tenantId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'contactPhone', 'country', 'currency', 'currencySymbol', 'branding', 'customDomain', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /tenantMemberships/{membershipId} {
      allow get: if isValidCompositeId(membershipId) && isSignedIn() && (
        isPlatformAdmin() ||
        existing().uid == request.auth.uid ||
        hasPermission(existing().tenantId, 'users.view')
      );
      allow list: if isSignedIn() && (
        isPlatformAdmin() ||
        existing().uid == request.auth.uid ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId && hasPermission(existing().tenantId, 'users.view'))
      );
      allow create: if isValidCompositeId(membershipId) && isSignedIn() && isValidTenantMembership(incoming()) &&
        membershipId == (incoming().tenantId + '_' + incoming().uid) &&
        incoming().membershipId == membershipId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          (
            isBootstrapOrgOwner(incoming().tenantId) &&
            incoming().uid == request.auth.uid &&
            incoming().isOwner == true &&
            incoming().status == 'active'
          ) ||
          (
            isTenantOperational(incoming().tenantId) &&
            hasPermission(incoming().tenantId, 'users.create') &&
            incoming().isOwner == false
          ) ||
          (
            isEmailVerified() &&
            incoming().uid == request.auth.uid &&
            incoming().isOwner == false &&
            incoming().status == 'active' &&
            exists(userPath(request.auth.uid)) &&
            get(userPath(request.auth.uid)).data.organizationId == incoming().tenantId &&
            get(userPath(request.auth.uid)).data.roleId == incoming().roleId
          )
        );
      allow update: if isValidCompositeId(membershipId) && isVerifiedOrProvisionedUser() && isValidTenantMembership(incoming()) &&
        incoming().membershipId == existing().membershipId &&
        incoming().tenantId == existing().tenantId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          (
            isTenantOperational(existing().tenantId) &&
            hasPermission(existing().tenantId, 'users.manage') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'roleId', 'branchIds', 'defaultBranchId', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /terminals/{terminalId} {
      allow get: if isValidId(terminalId) && isVerifiedOrProvisionedUser() && (isPlatformAdmin() || hasBranchAccess(existing().organizationId, existing().branchId));
      allow list: if isVerifiedOrProvisionedUser() && (isPlatformAdmin() || (hasUserProfile() && existing().organizationId == currentUser().organizationId));
      allow create: if isValidId(terminalId) && isSignedIn() && isValidTerminal(incoming()) &&
        exists(branchPath(incoming().branchId)) &&
        (
          isBootstrapOrgOwner(incoming().organizationId) ||
          (isTenantOperational(incoming().organizationId) && hasPermission(incoming().organizationId, 'branches.manage'))
        ) &&
        incoming().terminalId == terminalId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(terminalId) && isVerifiedOrProvisionedUser() && isValidTerminal(incoming()) &&
        isTenantOperational(existing().organizationId) &&
        incoming().terminalId == existing().terminalId &&
        incoming().organizationId == existing().organizationId &&
        incoming().branchId == existing().branchId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            hasPermission(existing().organizationId, 'branches.manage') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['terminalCode', 'name', 'deviceLabel', 'status', 'lastActiveAt', 'updatedAt'])
          ) ||
          (
            hasBranchAccess(existing().organizationId, existing().branchId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /plans/{planId} {
      allow get: if isValidId(planId) && isSignedIn();
      allow list: if isSignedIn() && existing().status in ['active', 'archived'];
      allow create, update: if isValidId(planId) && isPlatformAdmin() && isValidPlan(incoming()) &&
        incoming().planId == planId &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        isTenantMember(existing().tenantId) ||
        isOrgOwner(existing().tenantId)
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      allow create: if isValidId(subscriptionId) && isSignedIn() && isValidSubscription(incoming()) &&
        incoming().subscriptionId == subscriptionId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          (
            isBootstrapOrgOwner(incoming().tenantId) &&
            incoming().status == 'trial' &&
            incoming().paymentProvider == 'trial' &&
            incoming().planId in ['starter', 'professional']
          )
        );
      allow update: if isValidId(subscriptionId) && isPlatformAdmin() && isValidSubscription(incoming()) &&
        incoming().subscriptionId == existing().subscriptionId &&
        incoming().tenantId == existing().tenantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /subscriptionPayments/{paymentId} {
      allow get: if isValidId(paymentId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        hasPermission(existing().tenantId, 'settings.manage') ||
        hasPermission(existing().tenantId, 'reports.view')
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      // Authoritative payment records are written strictly by verified backend webhooks / Admin SDK.
      allow create, update, delete: if false;
    }

    match /usageTracking/{tenantId} {
      allow get: if isValidId(tenantId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        isTenantMember(tenantId) ||
        isOrgOwner(tenantId)
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      allow create, update: if isValidId(tenantId) && isSignedIn() && isValidUsageTracking(incoming()) &&
        incoming().tenantId == tenantId &&
        incoming().updatedAt == request.time && (
          isPlatformAdmin() ||
          isBootstrapOrgOwner(tenantId) ||
          isOrgMember(tenantId)
        );
      allow delete: if false;
    }

    match /featureOverrides/{overrideId} {
      allow get: if isValidId(overrideId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        isTenantMember(existing().tenantId)
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      allow create, update: if isValidId(overrideId) && isPlatformAdmin() && isValidFeatureOverride(incoming()) &&
        incoming().overrideId == overrideId &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /platformAdmins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin() && existing().isActive in [true, false];
      allow create, update: if isValidId(uid) && isPlatformAdmin() && isValidPlatformAdmin(incoming()) &&
        incoming().uid == uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /platformAuditLogs/{logId} {
      allow get: if isValidId(logId) && isPlatformAdmin();
      allow list: if isPlatformAdmin() && existing().actorUid is string;
      allow create: if isValidId(logId) && isPlatformAdmin() && isValidPlatformAuditLog(incoming()) &&
        incoming().logId == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        isTenantMember(existing().tenantId)
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().tenantId == currentUser().organizationId)
      );
      allow create: if isValidId(ticketId) && isVerifiedOrProvisionedUser() && isValidSupportTicket(incoming()) &&
        (isPlatformAdmin() || isTenantMember(incoming().tenantId)) &&
        incoming().ticketId == ticketId &&
        incoming().createdBy == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isPlatformAdmin() && isValidSupportTicket(incoming()) &&
        incoming().ticketId == existing().ticketId &&
        incoming().tenantId == existing().tenantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 5. Tenant Operational POS & Inventory Collection Rules

    match /organizations/{organizationId} {
      allow get: if isValidId(organizationId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        isTenantMember(organizationId) ||
        isOrgOwner(organizationId)
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        existing().ownerUid == request.auth.uid ||
        (hasUserProfile() && existing().organizationId == currentUser().organizationId)
      );
      allow create: if isValidId(organizationId) && isSignedIn() && isValidOrganization(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(organizationId) && isVerifiedOrProvisionedUser() && isValidOrganization(incoming()) &&
        (
          isPlatformAdmin() ||
          (isTenantOperational(organizationId) && hasPermission(organizationId, 'settings.manage'))
        ) &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'registrationNumber', 'logoUrl', 'email', 'phone', 'address', 'country', 'currency', 'currencySymbol', 'timezone', 'defaultTaxRateBps', 'taxLabel', 'allowNegativeInventory', 'status', 'updatedAt']);
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId) && isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        hasBranchAccess(existing().organizationId, branchId) ||
        hasPermission(existing().organizationId, 'branches.view')
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        isPlatformAdmin() ||
        (hasUserProfile() && existing().organizationId == currentUser().organizationId)
      );
      allow create: if isValidId(branchId) && isSignedIn() && isValidBranch(incoming()) &&
        exists(orgPath(incoming().organizationId)) &&
        (
          isBootstrapOrgOwner(incoming().organizationId) ||
          (isTenantOperational(incoming().organizationId) && hasPermission(incoming().organizationId, 'branches.create'))
        ) &&
        incoming().branchId == branchId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(branchId) && isVerifiedOrProvisionedUser() && isValidBranch(incoming()) &&
        isTenantOperational(existing().organizationId) &&
        (hasPermission(existing().organizationId, 'branches.edit') || hasPermission(existing().organizationId, 'branches.manage')) &&
        incoming().branchId == existing().branchId &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['branchCode', 'branchName', 'address', 'city', 'region', 'country', 'contactNumber', 'email', 'managerName', 'operatingHours', 'status', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformAdmin() ||
        hasPermission(existing().organizationId, 'users.view')
      );
      allow list: if isVerifiedOrProvisionedUser() && (
        existing().uid == request.auth.uid ||
        isPlatformAdmin() ||
        (hasUserProfile() && existing().organizationId == currentUser().organizationId && hasPermission(existing().organizationId, 'users.view'))
      );
      allow create: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (isBootstrapOrgOwner(incoming().organizationId) && incoming().uid == request.auth.uid && incoming().accountStatus == 'active') ||
          (isTenantOperational(incoming().organizationId) && hasPermission(incoming().organizationId, 'users.create')) ||
          (
            isEmailVerified() &&
            incoming().uid == request.auth.uid &&
            'invitationId' in incoming() &&
            exists(/databases/$(database)/documents/invitations/$(incoming().invitationId)) &&
            get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.email.lower() == request.auth.token.email.lower() &&
            incoming().organizationId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.organizationId &&
            incoming().roleId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.roleId &&
            incoming().branchIds == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.branchIds &&
            incoming().defaultBranchId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.defaultBranchId &&
            incoming().grantedPermissions.size() == 0 &&
            incoming().deniedPermissions.size() == 0 &&
            incoming().accountStatus == 'active'
          )
        );
      allow update: if isValidId(userId) && isVerifiedOrProvisionedUser() && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            request.auth.uid == userId &&
            existing().accountStatus == 'active' &&
            incoming().organizationId == existing().organizationId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'updatedAt'])
          ) ||
          (
            request.auth.uid == userId &&
            existing().accountStatus == 'active' &&
            exists(membershipPath(incoming().organizationId, userId)) &&
            get(membershipPath(incoming().organizationId, userId)).data.status == 'active' &&
            incoming().roleId == get(membershipPath(incoming().organizationId, userId)).data.roleId &&
            incoming().branchIds == get(membershipPath(incoming().organizationId, userId)).data.branchIds &&
            incoming().grantedPermissions.size() == 0 &&
            incoming().deniedPermissions.size() == 0 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['organizationId', 'roleId', 'branchIds', 'defaultBranchId', 'grantedPermissions', 'deniedPermissions', 'lastLogin', 'updatedAt'])
          ) ||
          (
            isBootstrapOrgOwner(incoming().organizationId) &&
            request.auth.uid == userId &&
            incoming().grantedPermissions.size() == 0 &&
            incoming().deniedPermissions.size() == 0 &&
            incoming().accountStatus == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['organizationId', 'roleId', 'branchIds', 'defaultBranchId', 'grantedPermissions', 'deniedPermissions', 'lastLogin', 'updatedAt'])
          ) ||
          (
            incoming().organizationId == existing().organizationId &&
            isTenantOperational(existing().organizationId) &&
            (hasPermission(existing().organizationId, 'users.edit') || hasPermission(existing().organizationId, 'users.manage') || hasPermission(existing().organizationId, 'users.suspend')) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'branchIds', 'defaultBranchId', 'roleId', 'grantedPermissions', 'deniedPermissions', 'accountStatus', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /roles/{roleId} {
      allow get: if isValidId(roleId) && isVerifiedOrProvisionedUser() && (isPlatformAdmin() || isOrgMember(existing().organizationId));
      allow list: if isVerifiedOrProvisionedUser() && (isPlatformAdmin() || (hasUserProfile() && existing().organizationId == currentUser().organizationId));
      allow create: if isValidId(roleId) && isSignedIn() && isValidRole(incoming()) &&
        (
          isBootstrapOrgOwner(incoming().organizationId) ||
          (isTenantOperational(incoming().organizationId) && hasPermission(incoming().organizationId, 'roles.create'))
        ) &&
        incoming().roleId == roleId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(roleId) && isVerifiedOrProvisionedUser() && isValidRole(incoming()) &&
        isTenantOperational(existing().organizationId) &&
        (hasPermission(existing().organizationId, 'roles.edit') || hasPermission(existing().organizationId, 'roles.manage')) &&
        incoming().roleId == existing().roleId &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'scope', 'permissions', 'isActive', 'updatedAt']);
      allow delete: if isValidId(roleId) && isVerifiedOrProvisionedUser() &&
        isTenantOperational(existing().organizationId) &&
        hasPermission(existing().organizationId, 'roles.delete') &&
        existing().isSystem == false;
    }

    match /permissions/{permissionId} {
      allow get: if isValidId(permissionId) && isVerifiedOrProvisionedUser() && (isPlatformAdmin() || isOrgMember(existing().organizationId));
      allow list: if isVerifiedOrProvisionedUser() && (isPlatformAdmin() || (hasUserProfile() && existing().organizationId == currentUser().organizationId));
      allow create, update: if isValidId(permissionId) && isSignedIn() && isValidPermissionDef(incoming()) &&
        (
          isBootstrapOrgOwner(incoming().organizationId) ||
          (isTenantOperational(incoming().organizationId) && hasPermission(incoming().organizationId, 'roles.manage'))
        );
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId) && (
        (isEmailVerified() && existing().email.lower() == request.auth.token.email.lower()) ||
        (isVerifiedOrProvisionedUser() && hasPermission(existing().organizationId, 'users.view'))
      );
      allow list: if (
        (isEmailVerified() && (
          existing().email == request.auth.token.email.lower() ||
          existing().email == request.auth.token.email
        )) ||
        (hasUserProfile() && existing().organizationId == currentUser().organizationId && hasPermission(existing().organizationId, 'users.view'))
      );
      allow create: if isValidId(invitationId) && isVerifiedOrProvisionedUser() && isValidInvitation(incoming()) &&
        isTenantOperational(incoming().organizationId) &&
        hasPermission(incoming().organizationId, 'users.create') &&
        incoming().invitationId == invitationId &&
        incoming().invitedBy == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(invitationId) && isValidInvitation(incoming()) &&
        incoming().invitationId == existing().invitationId &&
        incoming().organizationId == existing().organizationId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isEmailVerified() &&
            existing().status == 'pending' &&
            existing().email.lower() == request.auth.token.email.lower() &&
            incoming().status == 'accepted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            isVerifiedOrProvisionedUser() &&
            isTenantOperational(existing().organizationId) &&
            hasPermission(existing().organizationId, 'users.manage') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'roleId', 'branchIds', 'defaultBranchId', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

