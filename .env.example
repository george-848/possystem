# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (Cloud Run / Preview expects 3000 in AI Studio, or $PORT in Cloud Run)
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# RESEND_API_KEY: Optional server-side API key for sending automated staff invitation emails via Resend.
RESEND_API_KEY=""

# EMAIL_FROM: Optional verified sender email address (e.g. "Multi-Branch POS System <noreply@yourdomain.com>")
EMAIL_FROM=""

# PAYSTACK_SECRET_KEY: Server-side Paystack secret key (sk_test_... / sk_live_...) - NEVER expose to frontend
PAYSTACK_SECRET_KEY=""

# PAYSTACK_WEBHOOK_SECRET: Optional separate webhook signing secret (falls back to PAYSTACK_SECRET_KEY)
PAYSTACK_WEBHOOK_SECRET=""

# PLATFORM_ADMIN_EMAILS: Comma-separated list of authorized Super Admin emails
PLATFORM_ADMIN_EMAILS="appiahkubi848@gmail.com"

# DEPLOYMENT_MODE: shared (multi-tenant SaaS) | dedicated (single-tenant Enterprise GCP isolation)
DEPLOYMENT_MODE="shared"
DEDICATED_TENANT_ID=""
VITE_DEPLOYMENT_MODE="shared"
VITE_DEDICATED_TENANT_ID=""
VITE_APP_BRAND_NAME="Multi-Branch POS System"
